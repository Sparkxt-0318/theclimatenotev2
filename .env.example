# ─────────────────────────────────────────────────────────────────────────────
# The Climate Note — environment variables
#
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# In production these live in: GitHub Actions secrets (worker),
# Vercel env vars (web), and EAS secrets (mobile build-time only).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API. The anon key is safe to ship in the app; row-level
# security is what protects the data. The service role key bypasses RLS and
# must ONLY ever be used by the worker and server-side web routes.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Mobile build-time values ────────────────────────────────────────────────
# Expo INLINES these into the bundle when it is built, so they are not runtime
# configuration — a missing one produces a binary that can never work.
# app.config.ts refuses to build a preview or production profile without all of
# them.
#
# For EAS builds these must exist as EAS environment variables, NOT in a local
# .env — .env is gitignored, and EAS uploads via git, so it never reaches the
# builder:
#   eas env:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value "..."
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web (Next.js) — NEXT_PUBLIC_ values are exposed to the browser by design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Sign-In (native, no browser) ─────────────────────────────────────
# Google Cloud console → Credentials. You need BOTH:
#   iOS client ID  — identifies the app to the native SDK
#   Web client ID  — the audience Supabase validates the ID token against
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# The iOS client's REVERSED client ID, e.g. com.googleusercontent.apps.123-abc.
# Baked into Info.plist as the URL scheme Google's native sheet returns through.
# Wrong or missing means "Continue with Google" never comes back to the app.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Where the website is deployed. The app's privacy, terms and support links
# point here, and App Review checks that they resolve. Use the Vercel URL until
# a real domain exists.
EXPO_PUBLIC_SITE_URL=https://YOUR-PROJECT.vercel.app

# Run the app on sample data with no backend at all:
#   EXPO_PUBLIC_DEMO=1 npx expo run:ios
# preflight fails if this is set when building for release.
# EXPO_PUBLIC_DEMO=1

# From `eas init`. NOTE: eas init cannot write this itself, because it writes to
# a static app.json and this project uses a dynamic app.config.ts. Copy the ID
# it prints into your EAS environment variables by hand.
EAS_PROJECT_ID=

# ── Google Drive ingestion ──────────────────────────────────────────────────
# A service account with read-only access. Share the Drive folder with the
# service account's email address; no OAuth consent screen is involved.
# Paste the whole JSON key as a single-line string, or point at a file path.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# ── AI provider ─────────────────────────────────────────────────────────────
# ONE of these is required, not both. Gemini is the default because its free
# tier needs no billing account and one article a week sits far inside its
# limits. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pinned rather than a -latest alias, per Google's own production guidance.
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.5-flash-image

# Optional upgrade. NOTE: a ChatGPT Plus subscription does NOT include API
# access — the API bills separately at platform.openai.com and needs its own
# payment method.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini

# Force one provider. Omit to use whichever key is present, preferring Gemini.
# AI_PROVIDER=gemini

# ── Licence-clear image search ──────────────────────────────────────────────
# Both have free developer tiers. Wikimedia/NASA need no key.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ── App Store Connect API key (for `eas submit`) ────────────────────────────
# From App Store Connect -> Users and Access -> Integrations. The .p8 file goes
# at apps/mobile/private/AuthKey.p8, which is gitignored.
ASC_API_KEY_ISSUER_ID=
ASC_API_KEY_ID=

# ── Apple ───────────────────────────────────────────────────────────────────
# Used by the account-deletion Edge Function to revoke Sign in with Apple
# tokens, which App Review requires (guideline 5.1.1(v)).
APPLE_TEAM_ID=
APPLE_SERVICE_ID=com.theclimatenote.app
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Admin "Run ingestion now" button ────────────────────────────────────────
# Fine-grained PAT with "Contents: read & write" on this repo only, so the
# admin console can dispatch the worker without waiting for the cron.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=Sparkxt-0318/theclimatenotev2
