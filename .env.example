# ─────────────────────────────────────────────────────────────────────────────
# The Climate Note — environment variables
#
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# In production these live in: GitHub Actions secrets (worker),
# Vercel env vars (web), and EAS secrets (mobile build-time only).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API. The anon key is safe to ship in the app; row-level
# security is what protects the data. The service role key bypasses RLS and
# must ONLY ever be used by the worker and server-side web routes.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mobile reads these at build time (Expo requires the EXPO_PUBLIC_ prefix).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web (Next.js) — NEXT_PUBLIC_ values are exposed to the browser by design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Sign-In (native, no browser) ─────────────────────────────────────
# Google Cloud console → Credentials. You need BOTH:
#   iOS client ID  — identifies the app to the native SDK
#   Web client ID  — the audience Supabase validates the ID token against
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ── Google Drive ingestion ──────────────────────────────────────────────────
# A service account with read-only access. Share the Drive folder with the
# service account's email address; no OAuth consent screen is involved.
# Paste the whole JSON key as a single-line string, or point at a file path.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# ── AI providers ────────────────────────────────────────────────────────────
# NOTE: a ChatGPT Plus subscription does NOT include API access. Create a key
# at platform.openai.com and add a payment method (~$5 covers a year here).
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini

# Gemini (free tier is sufficient) — used for illustrative image generation.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── Licence-clear image search ──────────────────────────────────────────────
# Both have free developer tiers. Wikimedia/NASA need no key.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ── Apple ───────────────────────────────────────────────────────────────────
# Used by the account-deletion Edge Function to revoke Sign in with Apple
# tokens, which App Review requires (guideline 5.1.1(v)).
APPLE_TEAM_ID=
APPLE_SERVICE_ID=com.theclimatenote.app
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Admin "Run ingestion now" button ────────────────────────────────────────
# Fine-grained PAT with "Contents: read & write" on this repo only, so the
# admin console can dispatch the worker without waiting for the cron.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=Sparkxt-0318/theclimatenotev2
