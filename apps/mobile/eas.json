{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_ENV": "development" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_ENV": "preview" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_ENV": "production" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "//": "Set these from the App Store Connect API key. See store/SUBMISSION.md.",
        "ascApiKeyPath": "./private/AuthKey.p8",
        "ascApiKeyIssuerId": "REPLACE_WITH_ISSUER_ID",
        "ascApiKeyId": "REPLACE_WITH_KEY_ID"
      }
    }
  }
}
